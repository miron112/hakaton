# --- LLM (основной провайдер — Polza.ai, OpenAI-совместимый) ---
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://polza.ai/api/v1
LLM_API_KEY=your_polza_key_here
LLM_MODEL=openai/gpt-4o-mini

# --- Telegram-бот ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_EDITOR_CHAT_ID=
# TELEGRAM_DELETE_WEBHOOK=false   # true — снять вебхук с бота, если им пользовался другой сервис

# --- VK API (wall.get) ---
VK_TOKEN=

# --- Необязательное: значения по умолчанию заданы в radar/config.py ---
# DATABASE_URL=sqlite:///data/radar.db
# SOURCES_FILE=sources.yaml
# POLL_INTERVAL_MINUTES=15
# INITIAL_LOOKBACK_HOURS=24
# MAX_AGE_HOURS=48
# MIN_TEXT_LEN=40
# LLM_JSON_MODE=true
# LLM_CONCURRENCY=5
# LLM_MAX_ITEMS_PER_CYCLE=200
# EDITORIAL_PRIORITIES=Особых указаний нет.
# EXCLUDED_TOPICS=Федеральная повестка без связи с Югрой; реклама и розыгрыши.
# TOPICS=ЧП и происшествия, ЖКХ, транспорт и дороги, другое
# STOP_WORDS=розыгрыш,промокод,реклама
# DEDUP_WINDOW_HOURS=48
# DEDUP_SIM_THRESHOLD=0.90
# NOTIFY_MIN_IMPORTANCE=3
# NOTIFY_MIN_IMPORTANCE_SURGUT=2
# BREAKING_MIN_IMPORTANCE=4
# MAX_NOTIFICATIONS_PER_CYCLE=10
# NOTIFY_LOCAL_ONLY=false
# LOG_LEVEL=INFO
